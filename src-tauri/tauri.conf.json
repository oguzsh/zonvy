{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zonvy",
  "version": "0.1.0",
  "identifier": "com.zonvy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Zonvy",
        "width": 320,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "dragDropEnabled": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Offline local time for any city",
    "copyright": "City data © GeoNames, CC BY 4.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
